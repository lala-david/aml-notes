{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aml-kb/node.schema.json",
  "title": "AML KB Node",
  "description": "지식베이스 노드 공통 스키마. 클래스·술어·불변식 정의는 kb/schema/schema.yaml.",
  "type": "object",
  "required": [
    "id",
    "type",
    "layer",
    "label",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3,7}:[a-z0-9]{1,4}(-[a-z0-9][a-z0-9-]*)?$",
      "description": "{TYPE}:{namespace}-{slug} · 불변"
    },
    "type": {
      "type": "string",
      "enum": [
        "JUR",
        "ORG",
        "REG",
        "PROV",
        "OBL",
        "CTL",
        "CONCEPT",
        "RISK",
        "TYP",
        "TEC",
        "IND",
        "ASSET",
        "CHAIN",
        "PROTO",
        "VASP",
        "VEND",
        "CAP",
        "ACT",
        "SRC",
        "DOC",
        "ERA",
        "EVT",
        "ENF",
        "INC",
        "CASE",
        "FEED",
        "PROD"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "semantic",
        "dynamic",
        "funnel"
      ],
      "description": "funnel 은 지식 계층이 아니라 이를 채우는 수집 인프라"
    },
    "label": {
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "orig": {
          "type": "string",
          "description": "원어 명칭 (일본어·중국어 등)"
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "description": "2~3문장. 이 노드가 무엇인지."
    },
    "plain": {
      "type": "string",
      "description": "쉬운 말 한 문장. '이게 뭔데?' 에 답한다. 법률 표현을 쓰지 않으며 summary 를 대체하지 않고 그 앞에 선다. 정확성을 깎으면 안 된다.",
      "maxLength": 300
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "merged",
        "disputed"
      ],
      "default": "active"
    },
    "merged_into": {
      "type": "string",
      "pattern": "^[A-Z]{3,7}:[a-z0-9]{1,4}(-[a-z0-9][a-z0-9-]*)?$"
    },
    "merge_reason": {
      "type": "string"
    },
    "external_ids": {
      "type": "object",
      "description": "celex, law_go_kr, ecfr, lei, cik, wikidata, mitre_attack 등",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outEdge"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date",
      "description": "신선도 SLA 만료일. 초과 시 sla_expiry 신호 발생."
    },
    "curator_note": {
      "type": "string",
      "description": "판단 근거·주의사항. 사람이 읽는 메모."
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "A=T1/T2 원문 확인, B=T3 복수 일치, C=T4 단일, D=미검증"
    },
    "evidence": {
      "type": "object",
      "required": [
        "doc",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^DOC:[a-z0-9]{1,4}-[a-z0-9][a-z0-9-]*$"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "locator": {
          "type": "string",
          "description": "페이지·조문·섹션 등 문서 내 위치"
        },
        "quote": {
          "type": "string",
          "description": "원어 원문 인용. 번역본 인용 금지."
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "outEdge": {
      "type": "object",
      "required": [
        "predicate",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^[A-Z][A-Z_]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Z]{3,7}:[a-z0-9]{1,4}(-[a-z0-9][a-z0-9-]*)?$"
        },
        "qualifiers": {
          "type": "object",
          "description": "술어별 추가 속성. 허용 키는 schema.yaml 의 predicates[].qualifiers 로 검증."
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "recorded_at": {
          "type": "string",
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "merged"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "merged_into",
          "merge_reason"
        ]
      }
    },
    {
      "description": "Funnel 클래스는 semantic 계층에 올 수 없다",
      "if": {
        "properties": {
          "layer": {
            "const": "semantic"
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "type": {
              "enum": [
                "FEED",
                "PROD"
              ]
            }
          },
          "required": [
            "type"
          ]
        }
      }
    }
  ]
}
